MONGO_URI=mongodb://mongo:27017/poker-planning
JWT_SECRET=change-me-to-a-random-secret
# comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:5173
PORT=3000

# let anyone create a host account from the sign-in page ("true"/"false")
ALLOW_REGISTRATION=true
# optional: seed a host account on startup (password ≥ 12 chars)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# optional: Google OAuth "Web application" client ID → enables "Sign in with Google"
GOOGLE_CLIENT_ID=

# "true" (default) | "false" (plain-http setups) | "auto" (follow the request scheme, needs TRUST_PROXY)
COOKIE_SECURE=true
# unset = trust nobody | "private" = trust X-Forwarded-For from loopback/private-network proxies
TRUST_PROXY=
